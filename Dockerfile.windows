FROM docker.io/library/ubuntu:20.04

ARG THREADS=1
ARG QT_VERSION=v5.15.19-lts-lgpl
ENV SOURCE_DATE_EPOCH=1397818193

RUN apt -o APT::Cache-Start=251658240 update && \
    DEBIAN_FRONTEND=noninteractive apt -o APT::Cache-Start=251658240 install -y build-essential cmake g++-mingw-w64 gettext git libtool ninja-build pkg-config \
    python && \
    rm -rf /var/lib/apt/lists/*

RUN update-alternatives --set x86_64-w64-mingw32-g++ $(which x86_64-w64-mingw32-g++-posix) && \
    update-alternatives --set x86_64-w64-mingw32-gcc $(which x86_64-w64-mingw32-gcc-posix)

RUN git clone -b v0.18.5.1 --depth 1 https://github.com/monero-project/monero && \
    cd monero && \
    git reset --hard 4f92268d7c16741cfb41e5bbe2aa46cc260a9ea5 && \
    cp -a contrib/depends / && \
    cd .. && \
    rm -rf monero

RUN make -j$THREADS -C /depends HOST=x86_64-w64-mingw32 NO_QT=1

RUN git clone https://code.qt.io/qt/qt5.git -b ${QT_VERSION} --depth 1 && \
    cd qt5 && \
    git reset --hard dc2ac680fa9d0ef7b0d9520859593d13951bedea && \
    git submodule update --init --depth 1 qtbase qtdeclarative qtgraphicaleffects qtimageformats qtmultimedia qtquickcontrols qtquickcontrols2 qtsvg qttools qttranslations && \
    ./configure --prefix=/depends/x86_64-w64-mingw32 -xplatform win32-g++ \
    -device-option CROSS_COMPILE=/usr/bin/x86_64-w64-mingw32- \
    -I $(pwd)/qtbase/src/3rdparty/angle/include \
    -opensource -confirm-license -release -static -static-runtime -opengl dynamic -no-angle \
    -no-avx -no-openssl -no-sql-sqlite \
    -no-feature-qml-worker-script -no-openssl -no-sql-sqlite \
    -qt-freetype -qt-harfbuzz -qt-libjpeg -qt-libpng -qt-pcre -qt-zlib \
    -skip gamepad -skip location -skip qt3d -skip qtactiveqt -skip qtandroidextras \
    -skip qtcanvas3d -skip qtcharts -skip qtconnectivity -skip qtdatavis3d -skip qtdoc \
    -skip qtgamepad -skip qtlocation -skip qtmacextras -skip qtnetworkauth -skip qtpurchasing \
    -skip qtscript -skip qtscxml -skip qtsensors -skip qtserialbus -skip qtserialport \
    -skip qtspeech -skip qttools -skip qtvirtualkeyboard -skip qtwayland -skip qtwebchannel \
    -skip qtwebengine -skip qtwebsockets -skip qtwebview -skip qtwinextras -skip qtx11extras \
    -skip serialbus -skip webengine \
    -nomake examples -nomake tests -nomake tools && \
    make -j$THREADS && \
    make -j$THREADS install && \
    cd qttools/src/linguist/lrelease && \
    ../../../../qtbase/bin/qmake && \
    make -j$THREADS && \
    make -j$THREADS install && \
    cd ../../../.. && \
    rm -rf $(pwd)

RUN git clone -b libgpg-error-1.38 --depth 1 https://github.com/gpg/libgpg-error && \
    cd libgpg-error && \
    git reset --hard 71d278824c5fe61865f7927a2ed1aa3115f9e439 && \
    ./autogen.sh && \
    ./configure --disable-shared --enable-static --disable-doc --disable-tests \
    --host=x86_64-w64-mingw32 --prefix=/depends/x86_64-w64-mingw32 && \
    make -j$THREADS && \
    make -j$THREADS install && \
    cd .. && \
    rm -rf libgpg-error

RUN git clone -b libgcrypt-1.8.5 --depth 1 https://github.com/gpg/libgcrypt && \
    cd libgcrypt && \
    git reset --hard 56606331bc2a80536db9fc11ad53695126007298 && \
    ./autogen.sh && \
    ./configure --disable-shared --enable-static --disable-doc \
    --host=x86_64-w64-mingw32 --prefix=/depends/x86_64-w64-mingw32 \
    --with-gpg-error-prefix=/depends/x86_64-w64-mingw32 && \
    make -j$THREADS && \
    make -j$THREADS install && \
    cd .. && \
    rm -rf libgcrypt

# Rust toolchain for the fcmp++ static library that monero builds with
# `cargo build --target x86_64-pc-windows-gnu`. Install the pinned Linux-host
# compiler and windows-gnu std component directly from Rust dist archives. This
# avoids rustup's /proc/self/exe dependency, which breaks when this Linux image
# is built under Podman on FreeBSD.
#
# CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER: fcmp_pp_rust is a staticlib, so
# cargo must link it (staticlib still links the bundled std/runtime). With no
# per-target linker set, cargo falls back to the host `cc` (Linux gcc), which
# cannot emit a PE object and fails the windows-gnu link with "linking with cc
# failed, exit code 1". Bind it to the mingw cross-compiler already installed
# by g++-mingw-w64 (the posix variant selected above). This is cargo's
# documented CARGO_TARGET_<triple>_LINKER convention; no .cargo/config needed.
ARG RUST_VERSION=1.85.0
ENV CARGO_HOME=/opt/rust \
    CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER=x86_64-w64-mingw32-gcc \
    PATH="/opt/rust/bin:${PATH}"
RUN apt -o APT::Cache-Start=251658240 update && \
    DEBIAN_FRONTEND=noninteractive apt -o APT::Cache-Start=251658240 install -y xz-utils && \
    rm -rf /var/lib/apt/lists/* && \
    curl -fsSLO https://static.rust-lang.org/dist/rust-${RUST_VERSION}-x86_64-unknown-linux-gnu.tar.xz && \
    tar -xf rust-${RUST_VERSION}-x86_64-unknown-linux-gnu.tar.xz && \
    ./rust-${RUST_VERSION}-x86_64-unknown-linux-gnu/install.sh --prefix=/opt/rust --disable-ldconfig && \
    rm -rf rust-${RUST_VERSION}-x86_64-unknown-linux-gnu rust-${RUST_VERSION}-x86_64-unknown-linux-gnu.tar.xz && \
    curl -fsSLO https://static.rust-lang.org/dist/rust-std-${RUST_VERSION}-x86_64-pc-windows-gnu.tar.xz && \
    tar -xf rust-std-${RUST_VERSION}-x86_64-pc-windows-gnu.tar.xz && \
    ./rust-std-${RUST_VERSION}-x86_64-pc-windows-gnu/install.sh --prefix=/opt/rust --disable-ldconfig && \
    rm -rf rust-std-${RUST_VERSION}-x86_64-pc-windows-gnu rust-std-${RUST_VERSION}-x86_64-pc-windows-gnu.tar.xz && \
    chmod -R a+rX /opt/rust
